# Cross-compilation image for the Raspberry Pi 5 (Raspberry Pi OS Bookworm,
# arm64). Debian bookworm has the Pi's glibc (2.36) and libinput (1.22, which
# Slint's kms backend needs); cross 0.2.5's own aarch64 image is too old and
# its development image too new. Used by cross through Cross.toml.
FROM debian:bookworm

# deb.debian.org is slow from here, so the default is a Taiwan mirror. cross
# builds this image itself; to use another mirror, edit the ARG default below.
ARG DEBIAN_MIRROR=http://ftp.tw.debian.org/debian

RUN sed -i "s|http://deb.debian.org/debian$|${DEBIAN_MIRROR}|" /etc/apt/sources.list.d/debian.sources \
    && dpkg --add-architecture arm64 \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        crossbuild-essential-arm64 \
        gcc \
        libc6-dev \
        pkg-config \
        libasound2-dev:arm64 \
        libdrm-dev:arm64 \
        libfontconfig1-dev:arm64 \
        libgbm-dev:arm64 \
        libinput-dev:arm64 \
        libudev-dev:arm64 \
        libxkbcommon-dev:arm64 \
    && rm -rf /var/lib/apt/lists/*

ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc \
    CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc \
    CXX_aarch64_unknown_linux_gnu=aarch64-linux-gnu-g++ \
    PKG_CONFIG_ALLOW_CROSS=1 \
    PKG_CONFIG_LIBDIR=/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig
